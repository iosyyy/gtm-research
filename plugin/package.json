{
  "name": "@iosyyy/dsh-web-research",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "可修改的 Harness 网页研究台：两套 GTM 技能、可见浏览器、真实任务状态与本地报告。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "plan.js",
    "templates.json",
    "studio.css",
    "client.template.js",
    "build.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "skills.json",
    "custom-skills.js",
    "host-service.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-file-upload"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test *.test.mjs"
  }
}
